# Keep your EXISTING .env. This file is only an example.
TWITCH_BOT_APP_CLIENT_ID=CHANGE_ME
TWITCH_BOT_APP_CLIENT_SECRET=CHANGE_ME
TWITCH_BOT_ID=1293258394
TWITCH_OWNER_ID=494679299
# Falls back to TWITCH_OWNER_ID when absent. Use an explicit channel ID going forward.
TWITCH_CHANNEL_ID=494679299

# Existing Hiddify HTTP proxy; set an EMPTY value for direct/TUN access.
FGP_PROXY_URL=http://127.0.0.1:12334
TWITCH_REDIRECT_URI=http://localhost:4343/oauth/callback
TRULA_MUSIC_TOKEN=
FGP_LOG_LEVEL=INFO
FGP_LOG_CHAT=true
FGP_GREET_STREAM=true
FGP_PREFIX=!
# 0 preserves history. Set a positive number only to opt into automatic pruning.
FGP_CHAT_RETENTION_DAYS=0
